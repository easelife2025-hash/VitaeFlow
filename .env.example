# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Production canonical domain used for SEO metadata, canonical URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://ais-pre-6zm5vnqncwnbaa5e6ujfbf-641782429565.asia-southeast1.run.app"

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML meta tag verification code.
# Paste only the verification token string from Google Search Console -> Settings -> Ownership Verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Optional Google Analytics 4 (GA4) Measurement ID (e.g., "G-XXXXXXXXXX").
# Note: GA4 Measurement IDs are public client-side identifiers, not secret API keys. Leave empty to disable GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# AI_MAX_REQUESTS_PER_HOUR: Configurable server-side usage limit per client window for Gemini AI endpoints.
AI_MAX_REQUESTS_PER_HOUR="30"

# AI_RATE_WINDOW_MINUTES: Rolling time window in minutes for AI usage quota enforcement.
AI_RATE_WINDOW_MINUTES="60"
