# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Keep this secret server-side only (never prefix with NEXT_PUBLIC_).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://vitae-flow-xi.vercel.app"

# NEXT_PUBLIC_SITE_URL: Production canonical domain used for SEO metadata, canonical URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://vitae-flow-xi.vercel.app"

# Firebase Web App Configuration (Public Client-Side Identifiers for Firebase Auth & Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="vitaeflow-ada2d.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="vitaeflow-ada2d"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="vitaeflow-ada2d.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="703403591936"
NEXT_PUBLIC_FIREBASE_APP_ID="1:703403591936:web:4e22b1c7e5c36b2ec84be5"
NEXT_PUBLIC_FIREBASE_DATABASE_ID="ai-studio-vitaeflowairesum-0a5d0dcf-da34-4d15-8511-f2211bc4b9c6"

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML meta tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Optional Google Analytics 4 (GA4) Measurement ID (e.g., "G-XXXXXXXXXX").
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# AI_MAX_REQUESTS_PER_HOUR: Configurable server-side usage limit per client window for Gemini AI endpoints.
AI_MAX_REQUESTS_PER_HOUR="30"

# AI_RATE_WINDOW_MINUTES: Rolling time window in minutes for AI usage quota enforcement.
AI_RATE_WINDOW_MINUTES="60"
